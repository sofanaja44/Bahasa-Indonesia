=== daftar_metode
buat d adalah [3, 1, 2]
d.tambahkan(5)
tampilkan d, d.panjang()
d.urutkan()
tampilkan d
d.balik()
tampilkan d
tampilkan d.cari(2), d.cari(9)
d.sisipkan(0, "awal")
d.sisipkan(-1, "akhir-1")
d.sisipkan(100, "ujung")
d.sisipkan(-100, "depan")
tampilkan d
tampilkan d.hapusPosisi(0), d.hapusPosisi(-1), d
d.hapus(5)
tampilkan d
buat s adalah d.salin()
s.kosongkan()
tampilkan s, d
