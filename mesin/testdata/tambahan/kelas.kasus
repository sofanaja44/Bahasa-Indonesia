=== kelas_dasar
kelas Titik:
    buat x adalah 0
    buat y adalah 0
    fungsi geser(dx, dy):
        diri.x adalah diri.x + dx
        diri.y adalah diri.y + dy
        kembalikan diri
buat t adalah Titik()
t.geser(1, 2).geser(3, 4)
tampilkan t.x, t.y, t
=== kelas_atribut_tidak_ada
kelas K:
    buat nilai adalah 1
buat k adalah K()
tampilkan k.nilia
=== kelas_metode_tidak_ada
kelas K:
    fungsi hitung():
        kembalikan 1
buat k adalah K()
tampilkan k.hitng()
=== kelas_tanpa_inisialisasi_argumen
kelas K:
    buat a adalah 1
K(5)
=== kelas_inisialisasi_argumen_kurang
kelas K:
    fungsi inisialisasi(a, b):
        diri.a adalah a
K(1)
=== kelas_pewarisan_tiga
kelas A:
    buat a adalah 1
    fungsi nama():
        kembalikan "A"
    fungsi sapa():
        kembalikan "aku " + diri.nama()
kelas B mewarisi A:
    buat b adalah 2
    fungsi nama():
        kembalikan "B"
kelas C mewarisi B:
    fungsi nama():
        kembalikan "C+" + induk.nama()
buat c adalah C()
tampilkan c.sapa(), c.b
tampilkan c.a
=== kelas_induk_metode_tidak_ada
kelas A:
    fungsi f():
        kembalikan 1
kelas B mewarisi A:
    fungsi g():
        kembalikan induk.h()
B().g()
=== kelas_super
kelas A:
    fungsi inisialisasi(n):
        diri.n adalah n
kelas B mewarisi A:
    fungsi inisialisasi():
        super.inisialisasi(7)
tampilkan B().n
=== kelas_induk_tanpa_pewarisan
kelas A:
    fungsi f():
        kembalikan induk
A().f()
=== kelas_metode_dengan_diri
kelas K:
    fungsi f(diri, x):
        kembalikan x * 2
tampilkan K().f(4)
