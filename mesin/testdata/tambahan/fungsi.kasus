=== closure
fungsi pembuat(n):
    fungsi tambah(x):
        kembalikan x + n
    kembalikan tambah
buat t5 adalah pembuat(5)
tampilkan t5(1), pembuat(10)(1)
=== closure_penghitung
fungsi penghitung():
    buat hitung adalah 0
    fungsi naik():
        tambahkan 1 ke hitung
        kembalikan hitung
    kembalikan naik
buat c adalah penghitung()
c()
c()
tampilkan c()
=== closure_perulangan
buat fungsi_fungsi adalah []
untuk i dari 1 sampai 3:
    fungsi f():
        kembalikan i
    tambahkan f ke fungsi_fungsi
untuk setiap g dalam fungsi_fungsi:
    cetak g()
tampilkan
=== bawaan_parameter
fungsi sapa(nama, salam = "Halo", tanda = "!"):
    kembalikan salam + " " + nama + tanda
tampilkan sapa("Budi"), sapa("Ani", "Hai"), sapa("X", "Yo", "?")
=== bawaan_parameter_dievaluasi_saat_dipanggil
buat dasar adalah 1
fungsi f(x = dasar * 10):
    kembalikan x
tampilkan f()
dasar adalah 2
tampilkan f()
=== bawaan_parameter_daftar_baru
fungsi f(d = []):
    d.tambahkan(1)
    kembalikan d
tampilkan f(), f()
=== bawaan_parameter_galat
fungsi f(x = 1 / 0):
    kembalikan x
tampilkan f(5)
tampilkan f()
=== bawaan_parameter_memanggil_fungsi
fungsi dua():
    kembalikan 2
fungsi f(x = dua() * 3):
    kembalikan x
tampilkan f()
