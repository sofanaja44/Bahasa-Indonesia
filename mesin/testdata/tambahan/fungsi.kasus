=== fungsi_sebagai_argumen
fungsi terapkan(fn, nilai):
    kembalikan fn(nilai)
fungsi gandakan(x):
    kembalikan x * 2
tampilkan terapkan(gandakan, 21), terapkan(panjang, "abc"), terapkan(fungsi(x): x + 1, 1)
